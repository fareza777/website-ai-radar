# ─── Collector (scripts/collect.ts) ─────────────────────────────────────────────
# GitHub token: raises API limits for GitHub Search / repo metadata.
# In GitHub Actions the built-in GITHUB_TOKEN is used automatically.
GITHUB_TOKEN=

# Optional LLM for richer English summaries (any OpenAI-compatible endpoint).
# Without it, the pipeline still runs and uses deterministic templates.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-flash
# Max items summarized per run (caps cost). 0 disables LLM calls.
LLM_MAX_ITEMS=40

# Optional: Product Hunt API v2 developer token (Discover). Skipped when empty.
PRODUCT_HUNT_TOKEN=

# Optional: paid X API v2 bearer token for recent-search of launch posts. Without it, X buzz still
# arrives via tips (/submit) and newsletters, read through X's official oEmbed endpoint.
X_BEARER_TOKEN=

# Optional: Threads API access token (graph.threads.net) with threads_keyword_search / threads_profile_discovery.
# Without it, Threads posts are only added as link-only entries from tips.
THREADS_ACCESS_TOKEN=

# Set to 1 (GitHub Actions does this) to let the collector reply on/close tip issues.
TIPS_WRITEBACK=

# Accept items published within N days (initial backfill window).
BACKFILL_DAYS=90

# ─── Website (Next.js) ──────────────────────────────────────────────────────────
# Absolute URL for SEO metadata/sitemap. Leave empty on Vercel: the production domain attached to the project is used automatically
# (VERCEL_PROJECT_PRODUCTION_URL). Set it only to force a different canonical custom domain (a *.vercel.app value is ignored in production).
NEXT_PUBLIC_SITE_URL=
